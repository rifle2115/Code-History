# Required for the reasoning steps (classification, synthesis, verification)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional fallback, used automatically while Groq is over its daily limit.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional. Without it GitHub allows 60 API requests per hour.
# A fine-grained token with read-only "Public repositories" access is enough.
GITHUB_TOKEN=

# Optional tuning
# MAX_HISTORY_COMMITS=25
# MAX_DECISION_COMMITS=5
